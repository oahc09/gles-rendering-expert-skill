{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W1 bounded standalone compiler report",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "seed",
    "scope",
    "device",
    "extensions",
    "compiler",
    "compiler_version",
    "compiler_sha256",
    "limits",
    "cases",
    "generator_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE",
        "NOT_RUN"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "scope": {
      "type": "string"
    },
    "device": {
      "type": "null"
    },
    "extensions": {
      "type": "null"
    },
    "compiler": {
      "type": [
        "string",
        "null"
      ]
    },
    "compiler_version": {
      "type": [
        "object",
        "null"
      ]
    },
    "compiler_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "type": "object",
      "required": [
        "timeout_seconds",
        "budget_seconds",
        "memory_mb",
        "max_shader_bytes"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "budget_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 128,
          "maximum": 2048
        },
        "max_shader_bytes": {
          "type": "integer",
          "minimum": 512,
          "maximum": 65536
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 89,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "replay"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(300|310|320)-[a-z_]+(?:-[a-z_]+)*$"
          },
          "status": {
            "enum": [
              "PASS",
              "EXPECTED_ERROR",
              "MISMATCH",
              "COMPILER_FAILURE",
              "TEST_TIMEOUT",
              "RESOURCE_LIMIT",
              "HARNESS_FAILURE",
              "UNSUPPORTED",
              "BUDGET_EXHAUSTED",
              "BLOCKED_BY_TOOLCHAIN",
              "NOT_RUN"
            ]
          },
          "expected": {
            "enum": [
              "accept",
              "reject"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "log": {
            "type": "string"
          },
          "sha256": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "replay": {
            "type": "array",
            "minItems": 8,
            "items": {
              "type": "string"
            }
          },
          "output_image": {
            "type": "null"
          }
        }
      }
    },
    "generator_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
