{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gles": {
      "enum": [
        "3.0",
        "3.1",
        "3.2"
      ]
    },
    "blocks": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "ubo",
              "ssbo"
            ]
          },
          "layout": {
            "enum": [
              "std140",
              "std430"
            ]
          },
          "binding": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "float",
                    "int",
                    "uint",
                    "vec2",
                    "vec3",
                    "vec4",
                    "ivec2",
                    "ivec3",
                    "ivec4",
                    "mat2",
                    "mat3",
                    "mat4"
                  ]
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "array": {
                  "type": "integer",
                  "minimum": 1
                },
                "array_stride": {
                  "type": "integer",
                  "minimum": 0
                },
                "matrix_stride": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "name",
                "type",
                "offset"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "kind",
          "layout",
          "binding",
          "size",
          "members"
        ],
        "additionalProperties": false
      }
    },
    "samplers": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "sampler2D",
              "samplerCube",
              "isampler2D",
              "usampler2D",
              "sampler2DShadow"
            ]
          },
          "unit": {
            "type": "integer",
            "minimum": 0
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "type",
          "unit",
          "format"
        ],
        "additionalProperties": false
      }
    },
    "max_texture_units": {
      "type": "integer",
      "minimum": 1
    },
    "max_ubo_bindings": {
      "type": "integer",
      "minimum": 1
    },
    "max_ssbo_bindings": {
      "type": "integer",
      "minimum": 1
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "producer": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "array": {
                "type": "integer",
                "minimum": 1
              },
              "precision": {
                "enum": [
                  "lowp",
                  "mediump",
                  "highp"
                ]
              },
              "interpolation": {
                "enum": [
                  "smooth",
                  "flat",
                  "centroid"
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "consumer": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "array": {
                "type": "integer",
                "minimum": 1
              },
              "precision": {
                "enum": [
                  "lowp",
                  "mediump",
                  "highp"
                ]
              },
              "interpolation": {
                "enum": [
                  "smooth",
                  "flat",
                  "centroid"
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "producer",
          "consumer"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "gles",
    "blocks",
    "samplers"
  ],
  "additionalProperties": false
}
