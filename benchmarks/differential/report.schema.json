{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLES independent implementation differential report",
  "type": "object",
  "required": ["schema_version", "generated_at", "status", "evidence", "implementations", "cases", "executed_comparisons", "real_gpu_gate", "android_native_gate", "performance_comparison", "tolerances", "dependency_hashes"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "evidence": {"enum": ["HOST_REPRODUCED", "UNVERIFIED"]},
    "implementations": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
    "cases": {
      "type": "array", "items": {
        "type": "object", "required": ["id", "kind", "status", "source_sha256", "replay", "comparison_channels"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["shader", "api_error", "fbo_pixels", "ssbo_numeric"]},
          "status": {"enum": ["PASS", "FAIL", "SKIP_UNSUPPORTED", "UNKNOWN"]},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "replay": {"type": "string"},
          "comparison_channels": {"type": "object"},
          "reducer": {"type": "object", "required": ["status", "trials", "one_minimal", "predicate", "minimality_domain", "semantic_global_minimality"]}
        },
        "allOf": [{"if": {"properties": {"status": {"const": "FAIL"}}}, "then": {"required": ["reducer"]}}]
      }
    },
    "executed_comparisons": {"type": "integer", "minimum": 0},
    "real_gpu_gate": {"const": "BLOCKED_BY_HARDWARE"},
    "android_native_gate": {"const": "BLOCKED_BY_HARDWARE"},
    "performance_comparison": {"const": "NOT_MEASURED"},
    "tolerances": {"type": "object", "required": ["fbo", "ssbo"]},
    "dependency_hashes": {"type": "object"}
  }
}
