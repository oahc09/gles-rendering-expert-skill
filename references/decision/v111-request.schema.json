{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLES v1.1.1 offline decision request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "workload", "objective", "as_of"],
  "properties": {
    "schema_version": {"type":"integer","const":1},
    "as_of":{"type":"string","format":"date","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "allowed_actions":{"type":"array","uniqueItems":true,"items":{"enum":["analyze","propose"]},"contains":{"const":"analyze"}},
    "blocked_strategies":{"$ref":"#/$defs/tokens"},
    "target":{
      "type":"object","additionalProperties":false,
      "required":["gles","extensions","entrypoints","probes"],
      "properties":{
        "gles":{"enum":["2.0","3.0","3.1","3.2"]},
        "extensions":{"$ref":"#/$defs/tokens"},
        "entrypoints":{"$ref":"#/$defs/tokens"},
        "profile":{"$ref":"#/$defs/token"},
        "probes":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/token"},"additionalProperties":{"type":"boolean"}}
      }
    },
    "workload":{
      "type":"object","additionalProperties":false,"required":["labels"],
      "properties":{"labels":{"$ref":"#/$defs/tokens"},"discard_scope":{"$ref":"#/$defs/discard_scope"}}
    },
    "objective":{
      "type":"object","minProperties":1,
      "propertyNames":{"enum":["frame_time","bandwidth","memory","quality","power","startup"]},
      "additionalProperties":{"type":"number","minimum":0,"maximum":1},
      "not":{"additionalProperties":{"const":0}}
    }
  },
  "$defs":{
    "token":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"},
    "tokens":{"type":"array","maxItems":512,"uniqueItems":true,"items":{"$ref":"#/$defs/token"}},
    "discard_scope":{"type":"object","additionalProperties":false,"required":["attachment","end_event","complete","attachments","lifecycle"],"properties":{"attachment":{"$ref":"#/$defs/token"},"end_event":{"type":"integer","minimum":0,"maximum":255},"complete":{"type":"boolean"},"attachments":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/attachment"}},"lifecycle":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/attachment_event"}}}},
    "attachment":{"type":"object","additionalProperties":false,"required":["id","width","height","format","samples"],"properties":{"id":{"$ref":"#/$defs/token"},"width":{"type":"integer","minimum":1,"maximum":65536},"height":{"type":"integer","minimum":1,"maximum":65536},"format":{"$ref":"#/$defs/token"},"samples":{"enum":[1,2,4,8,16]},"initially_defined":{"type":"boolean"}}},
    "attachment_event":{"oneOf":[{"type":"object","additionalProperties":false,"required":["op","fbo","loads"],"properties":{"op":{"const":"begin"},"fbo":{"type":"string","minLength":1},"loads":{"type":"object","minProperties":1,"maxProperties":32,"propertyNames":{"$ref":"#/$defs/token"},"additionalProperties":{"enum":["load","clear","discard"]}}}},{"type":"object","additionalProperties":false,"required":["op","writes","coverage"],"properties":{"op":{"const":"draw"},"writes":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/token"},"uniqueItems":true},"coverage":{"enum":["full_overwrite","partial"]}}},{"type":"object","additionalProperties":false,"required":["op","fbo"],"properties":{"op":{"const":"switch"},"fbo":{"type":"string","minLength":1}}},{"type":"object","additionalProperties":false,"required":["op","attachment"],"properties":{"op":{"const":"resolve"},"attachment":{"$ref":"#/$defs/token"}}},{"type":"object","additionalProperties":false,"required":["op","stores"],"properties":{"op":{"const":"end"},"stores":{"type":"object","minProperties":1,"maxProperties":32,"propertyNames":{"$ref":"#/$defs/token"},"additionalProperties":{"enum":["store","discard"]}}}},{"type":"object","additionalProperties":false,"required":["op","attachment"],"properties":{"op":{"const":"consume"},"attachment":{"$ref":"#/$defs/token"}}}]}
  }
}
